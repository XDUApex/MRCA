{
  "schema_version": 1,
  "description": "Canonical RQ1 reproduction plan for the MRCA artifact. Historical tuning runs are intentionally not part of this file.",
  "experiment": "rq1",
  "python_module_prefix": "python -m",
  "stage1_profile": {
    "method": "vae",
    "entrypoint": "MRCA.anomaly_detection",
    "model": {
      "input_size": 2,
      "hidden_size": 128,
      "latent_size": 16,
      "kl_beta": 0.5
    },
    "dataset_training_params_from": "config.py: DATASET_CONFIG[*].training_params"
  },
  "stage2_profiles": {
    "standard_granger_fusion": {
      "entrypoint": "MRCA.rcl_unified",
      "method": "granger",
      "top_percentage": 0.8,
      "window_minutes": 10,
      "max_lag": 2,
      "scoring": "min",
      "fusion_alpha": 0.5,
      "fusion_beta": 0.5,
      "env": {}
    },
    "legacy_metric_pair_granger": {
      "entrypoint": "MRCA.rcl_unified",
      "method": "granger",
      "granger_only": true,
      "legacy": true,
      "top_percentage": 0.8,
      "window_minutes": 5,
      "max_lag": 2,
      "scoring": "min",
      "env": {}
    },
    "gaia_outflow": {
      "entrypoint": "MRCA.rcl_unified",
      "method": "granger_outflow",
      "top_percentage": 0.8,
      "window_minutes": 20,
      "max_lag": 2,
      "scoring": "avg",
      "fusion_alpha": 0.7,
      "fusion_beta": 0.3,
      "env": {
        "MRCA_RESAMPLE_RULE": "10S",
        "MRCA_OUTFLOW_SCORE_MODE": "net"
      }
    },
    "aiops_service_outflow": {
      "entrypoint": "MRCA.rcl_unified",
      "method": "granger_outflow",
      "top_percentage": 0.8,
      "window_minutes": 5,
      "max_lag": 2,
      "scoring": "min",
      "fusion_alpha": 0.0,
      "fusion_beta": 1.0,
      "env": {
        "MRCA_AIOPS_OUTFLOW_METRICS": "service_mean_response_time,service_request_rate,service_success_rate",
        "MRCA_OUTFLOW_SCORE_MODE": "outflow",
        "MRCA_OUTFLOW_CANDIDATE_GRAPH": "1"
      }
    },
    "aiops_service_outflow_fusion": {
      "entrypoint": "MRCA.rcl_unified",
      "method": "granger_outflow",
      "top_percentage": 0.8,
      "window_minutes": 5,
      "max_lag": 2,
      "scoring": "min",
      "fusion_alpha": 0.2,
      "fusion_beta": 0.5,
      "env": {
        "MRCA_AIOPS_OUTFLOW_METRICS": "service_mean_response_time,service_request_rate,service_success_rate",
        "MRCA_OUTFLOW_SCORE_MODE": "outflow",
        "MRCA_OUTFLOW_CANDIDATE_GRAPH": "1",
        "MRCA_AIOPS_SERVICE_LEVEL_FUSION": "1"
      }
    }
  },
  "runs": [
    {
      "dataset": "ob",
      "modality": "L",
      "stage": "stage1",
      "stage1_modality": "log",
      "expected": {"cases": 56, "hr_at_1": 0.1428571428571428, "hr_at_3": 0.3035714285714285, "hr_at_5": 0.5178571428571429}
